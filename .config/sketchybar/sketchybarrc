# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# Floating rounded bar with a gap from the screen edges
sketchybar --bar position=bottom \
                 height=36 \
                 margin=10 \
                 y_offset=5 \
                 corner_radius=12 \
                 padding_left=6 \
                 padding_right=6 \
                 color=0xe6121212 \
                 border_width=1 \
                 border_color=0xff333333 \
                 blur_radius=30

# The portrait (vertical) monitor gets a compact bar. Find it by shape so
# it keeps working if the screen order changes. VERTICAL / OTHERS are
# SketchyBar display numbers, e.g. "2" and "1,3".
DISPLAYS="$(sketchybar --query displays | python3 -c '
import json, sys
d = json.load(sys.stdin)
v = [str(x["arrangement-id"]) for x in d if x["frame"]["h"] > x["frame"]["w"]]
o = [str(x["arrangement-id"]) for x in d if x["frame"]["h"] <= x["frame"]["w"]]
print(",".join(v) or "none", ",".join(o) or "all")')"
VERTICAL="${DISPLAYS% *}"
OTHERS="${DISPLAYS#* }"
# Island (group) background
ISLAND=(background.color=0xff262626 background.corner_radius=8 background.height=26 background.drawing=on)

sketchybar --add event aerospace_workspace_change
for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid center \
        --set space.$sid \
	icon="$sid" \
	icon.font="UbuntuMono Nerd Font:Bold:14.0" \
	icon.padding_left=8 \
	icon.padding_right=5 \
	label.font="sketchybar-app-font:Regular:12.0" \
	label.color=0xffeaeaea \
	label.padding_right=8 \
	label.y_offset=0 \
	padding_left=3 \
	padding_right=3 \
        background.color=0x00000000 \
        background.corner_radius=1 \
        background.height=2 \
        background.y_offset=-11 \
        background.drawing=on \
        click_script="aerospace workspace $sid"
done

# One hidden item refreshes all workspaces (monitor, apps, highlight)
sketchybar --add item workspaces center \
           --set workspaces drawing=off updates=on script="$CONFIG_DIR/plugins/workspaces.sh" \
           --subscribe workspaces aerospace_workspace_change front_app_switched \
                                  space_windows_change display_change system_woke

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="UbuntuMono Nerd Font:Bold:16.0"
  label.font="UbuntuMono Nerd Font:Bold:14.0"
  icon.color=0xff8a8a8d
  label.color=0xffeaeaea
  icon.padding_left=2
  icon.padding_right=2
  label.padding_left=2
  label.padding_right=2
)
sketchybar --default "${default[@]}"

