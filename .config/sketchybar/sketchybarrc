##### Adding Left Items #####
# We add some regular items to the left side of the bar, where
# only the properties deviating from the current defaults need to be set
sketchybar --add item apple_icon left \
	   --set apple_icon icon="" icon.color=0xfff59e0b \
	   --set apple_icon icon.font="UbuntuMono Nerd Font:Bold:22.0" \
	   --set apple_icon icon.y_offset=1 icon.padding_left=6 icon.padding_right=2 padding_right=2 \
	   --set apple_icon click_script="osascript -e 'tell application \"System Events\" to keystroke \"q\" using {control down, command down}'"

sketchybar --add item chevron left \
           --set chevron icon= label.drawing=off \
           --add item front_app left \
           --set front_app icon.drawing=off display=$OTHERS script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# Compact app name for the vertical screen (cut to 10 characters)
if [ "$VERTICAL" != "none" ]; then
  sketchybar --add item front_app_v left \
             --set front_app_v icon.drawing=off display=$VERTICAL label.max_chars=10 \
                   script="$PLUGIN_DIR/front_app.sh" \
             --subscribe front_app_v front_app_switched
fi

# Pomodoro: left click start/pause, right click reset
sketchybar --add item pomodoro left \
           --set pomodoro icon="󰔛" script="$PLUGIN_DIR/pomodoro.sh" \
           --subscribe pomodoro mouse.clicked

# AeroSpace layout of the focused workspace + mode tag (service / resize)
sketchybar --add event aerospace_layout_change \
           --add event aerospace_mode_change \
           --add item layout left \
           --set layout label.drawing=off script="$PLUGIN_DIR/layout.sh" \
           --subscribe layout aerospace_workspace_change aerospace_layout_change front_app_switched \
           --add item aerospace_mode left \
           --set aerospace_mode drawing=off script="$PLUGIN_DIR/aerospace_mode.sh" \
                 icon.color=0xff121212 label.color=0xff121212 \
                 background.color=0xfff59e0b background.corner_radius=6 background.height=20 \
                 background.drawing=on icon.padding_left=6 label.padding_right=6 \
           --subscribe aerospace_mode aerospace_mode_change

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other items respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
           --set clock display=$OTHERS update_freq=1 script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

# CPU / RAM mini graphs (right items are laid out right-to-left,
# so these appear to the left of the battery)
graph=(
  graph.color=0xfff59e0b
  graph.fill_color=0x40f59e0b
  graph.line_width=1.0
  background.height=22
  background.drawing=on
  background.color=0x00000000
  label.width=30
  icon.font="UbuntuMono Nerd Font:Bold:13.0"
  icon.padding_right=4
  label.align=right
)
sketchybar --add graph ram right 40 \
           --set ram "${graph[@]}" display=$OTHERS icon="RAM" update_freq=5 script="$PLUGIN_DIR/ram.sh" \
           --add graph cpu right 40 \
           --set cpu "${graph[@]}" display=$OTHERS icon="CPU" update_freq=2 script="$PLUGIN_DIR/cpu.sh"

# Compact versions for the vertical screen: CPU/RAM without graphs,
# short clock
if [ "$VERTICAL" != "none" ]; then
  sketchybar --add item ram_v right \
             --set ram_v display=$VERTICAL icon="RAM" icon.font="UbuntuMono Nerd Font:Bold:13.0" \
                   update_freq=5 script="$PLUGIN_DIR/ram.sh" \
             --add item cpu_v right \
             --set cpu_v display=$VERTICAL icon="CPU" icon.font="UbuntuMono Nerd Font:Bold:13.0" \
                   update_freq=2 script="$PLUGIN_DIR/cpu.sh" \
             --add item clock_v right \
             --set clock_v display=$VERTICAL update_freq=10 \
                   script='sketchybar --set $NAME label="$(date +%H:%M)"' \
             --move clock_v before volume
fi

# Islands: each group gets its own rounded box
sketchybar --add bracket app_group apple_icon chevron front_app front_app_v \
           --set app_group "${ISLAND[@]}" \
           --add bracket pomodoro_group pomodoro \
           --set pomodoro_group "${ISLAND[@]}" \
           --add bracket aerospace_group layout aerospace_mode \
           --set aerospace_group "${ISLAND[@]}" \
           --add bracket spaces_group '/space\..*/' \
           --set spaces_group "${ISLAND[@]}" \
           --add bracket stats_group cpu ram cpu_v ram_v \
           --set stats_group "${ISLAND[@]}" \
           --add bracket power_group battery volume \
           --set power_group "${ISLAND[@]}" \
           --add bracket clock_group clock clock_v \
           --set clock_group "${ISLAND[@]}"

# Gaps between the islands: empty spacer items sitting outside the brackets
SPACER=(width=6 padding_left=0 padding_right=0 icon.drawing=off label.drawing=off background.drawing=off)
sketchybar --add item gap_pomodoro left --set gap_pomodoro "${SPACER[@]}" --move gap_pomodoro before pomodoro \
           --add item gap_layout left --set gap_layout "${SPACER[@]}" --move gap_layout before layout \
           --add item gap_power right --set gap_power "${SPACER[@]}" --move gap_power after battery \
           --add item gap_clock right --set gap_clock "${SPACER[@]}" --move gap_clock before volume

# Reload the bar when screens are connected / disconnected / rotated, so the
# per-screen layout above is recalculated
sketchybar --add item displays left \
           --set displays drawing=off updates=on script="$PLUGIN_DIR/displays.sh" \
           --subscribe displays display_change system_woke

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
